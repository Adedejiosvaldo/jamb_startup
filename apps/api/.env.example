NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scorecoach?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/scorecoach?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
OTP_HASH_SECRET=change-me-change-me-change-me-change-me
# console | termii   (console prints the OTP to the API log; never use in production)
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=ScoreCoach
TERMII_BASE_URL=https://api.ng.termii.com
WEB_URL=http://localhost:3000
# paystack | fake  (fake lets you simulate a successful payment locally)
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=
PAYMENT_EMAIL_DOMAIN=pay.scorecoach.ng
SUPPORT_WHATSAPP=
# Deployment tier: development | staging | production. Vercel forces NODE_ENV=production,
# so set APP_ENV=staging there. Only production refuses console SMS / fake payments.
APP_ENV=development
# Staging/dev only: every OTP is this code (no SMS needed). Refused when APP_ENV=production.
DEV_FIXED_OTP=
